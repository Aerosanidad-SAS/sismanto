NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Clave service role (solo servidor; crear usuarios desde /admin/usuarios)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Opcional: aplicar migraciones SQL desde tu PC (npm run db:apply)
# Supabase → Settings → Database → Connection string → URI (sustituir [YOUR-PASSWORD])
# DATABASE_URL=postgresql://postgres.[ref]:TU_PASSWORD@aws-0-....pooler.supabase.com:6543/postgres

# Opcional: email del usuario Auth al que enlazar como admin al ejecutar db:apply
# ADMIN_SETUP_EMAIL=innovizar@aerosanidadsas.com
