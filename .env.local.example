NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Clave service role (solo servidor; crear usuarios desde /admin/usuarios)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Opcional: aplicar migraciones SQL desde tu PC (npm run db:apply)
# Cadena Postgres en el dashboard (UI reciente): botón "Connect" arriba → elige Direct / Session / Transaction y copia la URI.
# Alternativa: engranaje "Project settings" (abajo en la barra lateral) → Database → Connection string / Connection info.
# Sustituir [YOUR-PASSWORD] por la contraseña de la BD del proyecto (URL-encode caracteres especiales en la URI).
# Si "Direct" falla (p. ej. ENOTFOUND en Windows), usa Session pooler desde Connect — suele resolver en IPv4:
# DATABASE_URL=postgresql://postgres.[ref]:TU_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres

# Opcional: email del usuario Auth al que enlazar como admin al ejecutar db:apply
# ADMIN_SETUP_EMAIL=innovizar@aerosanidadsas.com

# ── IA + extracción de facturas ───────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Microsoft Graph / OneDrive ────────────────────────────────────────────────
# Azure AD app registration (client credentials / app-only)
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret
# UPN (email) del usuario cuyo OneDrive se usa (ej: luzmary@aerosanidadsas.com)
ONEDRIVE_USER=luzmary@aerosanidadsas.com
# Ruta relativa de la carpeta donde Luzmary sube las facturas entrantes (ej: Facturas/Entrada)
ONEDRIVE_INPUT_FOLDER=Facturas/Entrada
# Ruta relativa de la carpeta "📋 POR REVISAR" para facturas con baja confianza
ONEDRIVE_REVIEW_FOLDER=Facturas/Por Revisar
# Cadena aleatoria para validar notificaciones del webhook de Graph (OBLIGATORIO)
GRAPH_WEBHOOK_SECRET=

# ── WhatsApp (webhook de entregas y lecturas) ────────────────────────────────
# Token que TÚ eliges y escribes también en Meta (Webhooks → Verify token). Sin él, la verificación (GET) se rechaza.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Secreto de la app de Meta (App settings → Basic → App secret). OBLIGATORIO: firma cada evento; sin él el webhook responde 503.
WHATSAPP_APP_SECRET=

# ── Vercel ────────────────────────────────────────────────────────────────────
# URL pública del despliegue (sin trailing slash). Necesaria para registrar el webhook.
NEXT_PUBLIC_APP_URL=https://aeromanto.vercel.app
# Vercel Cron Secret — Vercel lo inyecta automáticamente en producción.
# Para pruebas locales puedes definirlo manualmente.
# CRON_SECRET=
