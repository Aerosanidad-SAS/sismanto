NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Clave service role (solo servidor; crear usuarios desde /admin/usuarios)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Opcional: aplicar migraciones SQL desde tu PC (npm run db:apply)
# Cadena Postgres en el dashboard (UI reciente): botón "Connect" arriba → elige Direct / Session / Transaction y copia la URI.
# Alternativa: engranaje "Project settings" (abajo en la barra lateral) → Database → Connection string / Connection info.
# Sustituir [YOUR-PASSWORD] por la contraseña de la BD del proyecto (URL-encode caracteres especiales en la URI).
# Si "Direct" falla (p. ej. ENOTFOUND en Windows), usa Session pooler desde Connect — suele resolver en IPv4:
# DATABASE_URL=postgresql://postgres.[ref]:TU_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres

# Opcional: email del usuario Auth al que enlazar como admin al ejecutar db:apply
# ADMIN_SETUP_EMAIL=innovizar@aerosanidadsas.com
